{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PYLA",
  "version": "0.2.0",
  "identifier": "space.pyla.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "PYLA — firewall",
        "width": 1180,
        "height": 760,
        "minWidth": 860,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "category": "Utility",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "copyright": "Copyright (c) 2026 The PYLA Project Authors",
    "shortDescription": "Gestione grafica del firewall UFW",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  }
}
