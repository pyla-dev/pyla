<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>PYLA</vendor>
  <action id="space.pyla.app.helper">
    <description>Manage the UFW firewall with PYLA</description>
    <description xml:lang="it">Gestire il firewall UFW con PYLA</description>
    <message>Authentication is required to read or change the firewall rules</message>
    <message xml:lang="it">Serve l'autenticazione per leggere o modificare le regole del firewall</message>
    <icon_name>security-high</icon_name>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <!-- auth_admin_keep: dopo l'autenticazione polkit non richiede di nuovo per ~5 minuti -->
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/libexec/pyla/pyla-helper</annotate>
  </action>
</policyconfig>
